class Solution 
{
    public int minMoves(int[] nums) 
    {
        int max1=Integer.MIN_VALUE;
        int n=nums.length;
        int min1=Integer.MAX_VALUE;
        for(int i=0;i<n;i++)
        {
            min1=Math.min(min1,nums[i]);
        }           
        if(max1==min1)
            return 0;
        int res=0;
        for(int i=0;i<n;i++)
        {
            res+=Math.abs(nums[i]-min1);
        }
        return res;
    }
}
