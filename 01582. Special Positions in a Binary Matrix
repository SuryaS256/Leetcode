class Solution 
{
    public int numSpecial(int[][] mat) 
    {
       int rows = mat.length;
       int cols = mat[0].length;
       int countRow[] = new int[rows];
       int countCol[] = new int[cols];
       int res=0;

       for(int i=0;i<rows;i++)
       {
            for(int j=0;j<cols;j++)
            {
                if(mat[i][j]==1)
                {
                    countRow[i]++;
                    countCol[j]++;
                }    
            }
       } 
       for(int i=0;i<rows;i++)
       {
            for(int j=0;j<cols;j++)
            {
                if(mat[i][j]==1)
                {
                    if(countRow[i]==1 && countCol[j]==1)
                        res++;
                }
            }
       }
       return res;
    }
}
