class Solution 
{
    public ListNode addTwoNumbers(ListNode l1, ListNode l2) 
    {
        ListNode dummy=new ListNode(0);
        ListNode cur=dummy;
        if(l1==null)
            return l2;
        if(l2==null)
            return l1;
        ListNode cur1=l1;
        ListNode cur2=l2;
        int sum=0;
        int carry=0;
        while(cur1!=null || cur2!=null)
        {
            sum=0;
            sum+=carry;
            carry=0;
            if(cur1!=null)
            {
                sum+=cur1.val;
                cur1=cur1.next;
            }
            if(cur2!=null)
            {
                sum+=cur2.val;
                cur2=cur2.next;
            }
            if(sum>9)
            {
                carry=1;
                sum=sum%10;
            }
            ListNode new1=new ListNode(sum);
            cur.next=new1;
            cur=cur.next;
        }
        if(carry!=0)
        {
            ListNode new1=new ListNode(carry);
            cur.next=new1;
        }
        return dummy.next;
    }
}
