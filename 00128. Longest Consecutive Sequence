class Solution 
{
    public int longestConsecutive(int[] nums) 
    {
        int n=nums.length;
        if(n==0)
            return 0;
        int res=1;
        HashSet<Integer> h = new HashSet<>();
        for(int num:nums)
        {
            h.add(num);
        } 
        for(int num:h)
        {
            if(!h.contains(num-1))
            {
                int count=1;
                int start=num+1;
                while(h.contains(start))
                {
                    count++;
                    start++;
                }
                res=Math.max(res,count);
            }
        }
        return res;
    }
}
